# ============================================================================
# CRECO – Environment Variables
# Copy this file to .env.local and fill in real values for local dev.
# Production values live in the Vercel dashboard (Project Settings → Env Vars).
# ============================================================================

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NODE_ENV=development

# ── Supabase (CRECO has its own project — do not share with the residential site) ──
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Database connection for Payload CMS / Drizzle (Session Pooler, port 5432).
# Get from: Supabase Dashboard → Project Settings → Database → Session Pooler
# URL-encode special chars in the password: @ → %40, ! → %21, # → %23, $ → %24
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# ── Payload CMS ─────────────────────────────────────────────────────────────
# Random 32+ char string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# ── Vercel Blob Storage (property photos via Payload) ───────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Email (Resend) — outbound contact-form + tenant-needs notifications ─────
RESEND_API_KEY=re_xxxxxxxxxxxxx
LEAD_NOTIFICATION_EMAIL=zack@crecotx.com

# Once your domain is verified in Resend (resend.com/domains) and you've added
# the SPF/DKIM/DMARC DNS records at Cloudflare, set this to "true" to switch
# the FROM address from `onboarding@resend.dev` (Resend's shared sender) to
# `noreply@crecotx.com` (much better deliverability).
RESEND_FROM_VERIFIED=
# Optional override — explicit FROM address. Falls back to noreply@crecotx.com
# when RESEND_FROM_VERIFIED=true, or onboarding@resend.dev otherwise.
RESEND_FROM_EMAIL=

# ── reCAPTCHA v3 — spam protection on every lead form ──────────────────────
# Register at https://www.google.com/recaptcha/admin/create (Score-based, v3)
# When BOTH keys are set, the client requests a token on each form submit and
# the server verifies it against Google. Score < 0.5 = blocked. When EITHER
# key is missing, reCAPTCHA is bypassed (fail-open) so dev still works.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Analytics ───────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX) — from analytics.google.com
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity Project ID — from clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=
# Google Search Console verification token — only set if using HTML-tag method
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── CRM bridge ─────────────────────────────────────────────────────────────
# The CRM mirror in src/lib/crm.ts uses the existing
# SUPABASE_SERVICE_ROLE_KEY (set above) to write directly to the shared
# Fair Oaks Realty Group `crm_clients` + `email_lead_imports` tables.
# No additional env vars are required — leads land under the Prospects
# tab on the commercial CRM dashboard automatically.
